{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$ROOT/scripts/codex-hook-adapter.py\" PreToolUse",
            "timeout": 600,
            "statusMessage": "Running repo Codex hook adapter"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$ROOT/scripts/codex-hook-adapter.py\" SessionStart",
            "timeout": 30,
            "statusMessage": "Loading Monori handoff context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$ROOT/scripts/codex-hook-adapter.py\" Stop",
            "timeout": 30,
            "statusMessage": "Checking Monori handoff reminder"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$ROOT/scripts/codex-hook-adapter.py\" UserPromptSubmit",
            "timeout": 30,
            "statusMessage": "Loading Monori critical rules"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$ROOT/scripts/codex-hook-adapter.py\" PreCompact",
            "timeout": 30,
            "statusMessage": "Preserving Monori critical rules"
          }
        ]
      }
    ]
  }
}
